configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "JetBrainsMono Nerd Font 12";
  display-drun: "  ";
  drun-display-format: "{name}";
}
* {
  bg: #1e1e2eee;
  bg-alt: #313244;
  fg: #cdd6f4;
  accent: #cba6f7;
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 560px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 14px;
  padding: 16px;
}
mainbox { spacing: 12px; children: [inputbar, listview]; }
inputbar {
  background-color: @bg-alt;
  border-radius: 10px;
  padding: 10px 14px;
  spacing: 10px;
  children: [prompt, entry];
}
prompt { text-color: @accent; }
listview { lines: 8; columns: 1; spacing: 4px; scrollbar: false; }
element { padding: 8px 12px; border-radius: 8px; spacing: 10px; }
element selected.normal { background-color: @accent; text-color: #1e1e2e; }
element-icon { size: 24px; }
